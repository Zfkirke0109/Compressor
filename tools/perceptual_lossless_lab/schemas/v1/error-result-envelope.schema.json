{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Common pre-operation error result v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "dry_run", "exit_code", "error", "result", "content_sha256"],
  "properties": {
    "schema_version": {"const": "1"},
    "status": {"const": "ERROR"},
    "dry_run": {"const": false},
    "exit_code": {"enum": [10, 11, 12, 13, 14, 15]},
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "details"],
      "properties": {
        "code": {"type": "string"},
        "message": {"type": "string"},
        "details": {"type": "object"}
      }
    },
    "result": {"type": "object", "additionalProperties": false, "properties": {}},
    "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
