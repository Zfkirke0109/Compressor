{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "pl_run_boundary_suite request v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "operation_id", "run_id", "experiment_spec_sha256", "payload"],
  "properties": {
    "schema_version": {"const": "1"},
    "operation_id": {"const": "pl_run_boundary_suite"},
    "run_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$"},
    "experiment_spec_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": {"enum": ["fast", "expensive"]},
        "max_candidates": {"type": "integer", "minimum": 1},
        "max_workers": {"const": 1},
        "max_duration_seconds": {"type": "integer", "minimum": 1},
        "max_storage_bytes": {"type": "integer", "minimum": 1}
      }
    }
  }
}
