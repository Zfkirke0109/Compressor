{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "pl_pts_compare request v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "operation_id", "run_id", "experiment_spec_sha256", "payload"],
  "properties": {
    "schema_version": {"const": "1"},
    "operation_id": {"const": "pl_pts_compare"},
    "run_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$"},
    "experiment_spec_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_evaluation_sha256", "reference_pts_us", "candidate_pts_us"],
      "properties": {
        "input_evaluation_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "reference_pts_us": {"type": "array", "minItems": 1, "items": {"type": "integer"}},
        "candidate_pts_us": {"type": "array", "minItems": 1, "items": {"type": "integer"}}
      }
    }
  }
}
