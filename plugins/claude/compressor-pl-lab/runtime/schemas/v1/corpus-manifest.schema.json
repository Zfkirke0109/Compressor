{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Perceptual-lossless corpus pair manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "items"],
  "properties": {
    "schema_version": {"const": "1"},
    "items": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["pair_id", "source_path", "source_sha256", "source_size_bytes", "output_path", "output_sha256", "output_size_bytes"],
        "properties": {
          "pair_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$"},
          "source_path": {"type": "string", "pattern": "^(?!/)(?!.*[/]$)(?![A-Za-z]:)(?!.*[<>:\"|?*\\u0000-\\u001F])(?!.*(?:^|/)[^/]*[ .](?:/|$))(?!.*\\\\)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*//).+$"},
          "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "source_size_bytes": {"type": "integer", "minimum": 1},
          "output_path": {"type": "string", "pattern": "^(?!/)(?!.*[/]$)(?![A-Za-z]:)(?!.*[<>:\"|?*\\u0000-\\u001F])(?!.*(?:^|/)[^/]*[ .](?:/|$))(?!.*\\\\)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*//).+$"},
          "output_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "output_size_bytes": {"type": "integer", "minimum": 1}
        }
      }
    }
  }
}
